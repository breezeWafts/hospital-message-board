# ============ 医院匿名留言板系统 后端环境变量（本地开发示例）============
# 复制为 .env 后按需修改；部署到 Docker 时由 docker-compose 注入

# 数据库（PostgreSQL 18，UTF8）
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/hospital_board
POOL_MIN_SIZE=2
POOL_MAX_SIZE=10

# JWT
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# 匿名查询验证码（只存哈希：sha256 + secret）
CAPTCHA_SECRET=please-change-me-captcha-secret
CAPTCHA_TTL_DAYS=30
CAPTCHA_MAX_ATTEMPTS=5
CAPTCHA_LOCK_DAYS=30

# 附件
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
MAX_FILES_PER_SUBMIT=10

# 前端地址（OAuth2 回调后重定向目标、CORS）
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# 登录锁定
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# 防刷（IP 限流与黑名单）
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
BLACKLIST_BAN_SECONDS=86400
ANON_SUBMIT_COOLDOWN_SECONDS=10

# 统一认证中心（自定义 OAuth2 授权码模式）
OAUTH2_AUTHORIZE_URL=
OAUTH2_TOKEN_URL=
OAUTH2_USERINFO_URL=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=http://localhost:8000/api/auth/oauth2/callback
OAUTH2_SCOPE=
