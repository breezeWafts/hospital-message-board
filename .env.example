# ============ 医院匿名留言板系统 环境变量（docker compose 使用）============
# 复制为 .env 后按需修改

# 数据库（PostgreSQL 18，UTF8）
POSTGRES_PASSWORD=postgres

# 对外端口
WEB_PORT=8080

# JWT 与验证码密钥（生产环境务必修改）
JWT_SECRET=please-change-me-to-a-long-random-string
CAPTCHA_SECRET=please-change-me-captcha-secret

# 统一认证中心（自定义 OAuth2 授权码模式；留空则统一认证入口返回未配置提示）
OAUTH2_AUTHORIZE_URL=
OAUTH2_TOKEN_URL=
OAUTH2_USERINFO_URL=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=http://localhost:8080/api/auth/oauth2/callback
OAUTH2_SCOPE=
